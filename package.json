{
  "name": "@miruamel/zhi",
  "version": "0.1.6",
  "type": "module",
  "maturity": "experimental",
  "description": "Autonomous terminal coding agent with multi-critic loop engine (Bun-native TS).",
  "bin": {
    "zhi": "./dist/src/cli/index.js"
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./engine/*": "./dist/engine/*.js",
    "./src/*": "./dist/src/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGES.md",
    "AGENTS.md",
    "AGENTS.Style.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:ci": "bun test --coverage --reporter=junit --reporter-outfile=coverage/coverage.xml",
    "gate": "bun run scripts/gate.ts --if-changed",
    "test:watch": "bun test --watch",
    "lint": "bun x eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "bun x eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "bun x prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "bun x prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "typecheck:node": "bun x tsc --noEmit -p tsconfig.node.json",
    "typecheck:lib": "bun x tsc --noEmit -p tsconfig.lib.json",
    "arch:check": "bun run scripts/ci/architecture/check-circular.ts",
    "arch:metrics": "bun run scripts/ci/architecture/metrics.ts",
    "native:build": "cd native/stream && bash build.sh",
    "build": "bun run scripts/build.ts",
    "prepare": "",
    "prepublishOnly": "bun run gate && bun run native:build && bun run build",
    "commit": "commitlint --edit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miruamel/zhi.git"
  },
  "bugs": {
    "url": "https://github.com/miruamel/zhi/issues"
  },
  "homepage": "https://github.com/miruamel/zhi#readme",
  "keywords": [
    "autonomous-agent",
    "coding-agent",
    "bun",
    "typescript",
    "critic-loop",
    "zig",
    "wasm",
    "sse"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/react": "^18.3.31",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "bun-types": "^1.4.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.5",
    "eslint-visitor-keys": "^5.0.1",
    "gitleaks": "^1.0.0",
    "husky": "^9.1.7",
    "ink": "4.4.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.0.0",
    "react": "18.3.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bun run lint:fix",
      "bun run format"
    ],
    "*.{json,md,yml,yaml}": [
      "bun run format"
    ]
  },
  "license": "MIT"
}
