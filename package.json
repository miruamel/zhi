{
  "name": "@miruamel/zhi",
  "version": "0.1.4",
  "type": "module",
  "maturity": "experimental",
  "description": "Autonomous terminal coding agent with multi-critic loop engine (Bun-native TS).",
  "bin": {
    "zhi": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine/*": "./dist/engine/*.js",
    "./src/*": "./dist/src/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGES.md",
    "AGENTS.md",
    "AGENTS.Style.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:ci": "bun test --coverage --reporter=junit --reporter-outfile=coverage/coverage.xml",
    "gate": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "test:watch": "bun test --watch",
    "lint": "bun x eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "bun x eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "bun x prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "bun x prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "typecheck:node": "bun x tsc --noEmit -p tsconfig.node.json",
    "typecheck:lib": "bun x tsc --noEmit -p tsconfig.lib.json",
    "arch:check": "bun run scripts/ci/architecture/check-circular.ts",
    "arch:metrics": "bun run scripts/ci/architecture/metrics.ts",
    "native:build": "cd native/stream && bash build.sh",
    "build": "bun run scripts/build.ts",
    "prepare": "",
    "prepublishOnly": "bun run gate && bun run native:build",
    "commit": "commitlint --edit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miruamel/zhi.git"
  },
  "bugs": {
    "url": "https://github.com/miruamel/zhi/issues"
  },
  "homepage": "https://github.com/miruamel/zhi#readme",
  "keywords": [
    "autonomous-agent",
    "coding-agent",
    "bun",
    "typescript",
    "critic-loop",
    "zig",
    "wasm",
    "sse"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "ink": "^4",
    "react": "^18",
    "@types/react": "^18"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "bun-types": "1.4.0",
    "eslint": "10.9.1",
    "eslint-plugin-jsdoc": "^64.3.3",
    "eslint-visitor-keys": "^5.0.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bun run lint:fix",
      "bun run format"
    ],
    "*.{json,md,yml,yaml}": [
      "bun run format"
    ]
  },
  "license": "MIT"
}
